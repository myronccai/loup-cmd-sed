@mode(host.dual)

# Application identity and exit statuses of sed. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual. Constants compiled into the native binary build/sed by
# `make build`; `loup run source/main.loup` and the unit tests (`make test`,
# Stage0) use the same definitions.

pub const APP_NAME: string = "sed";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Stream editor for filtering and transforming text (a Loup recreation of GNU sed).";

# Exit statuses returned by main(), as in GNU sed.
pub const EXIT_OK: int = 0;
pub const EXIT_BAD_USAGE: int = 1;   # invalid option, command, syntax or regex
pub const EXIT_BAD_INPUT: int = 2;   # an input file could not be opened
pub const EXIT_PANIC: int = 4;       # an I/O error while running
