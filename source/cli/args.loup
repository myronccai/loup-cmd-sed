@mode(host.dual)

# Command-line parsing for sed, following GNU getopt_long: options may appear
# anywhere before `--`, short options combine (`-nE`), `-e` and `-f` take the
# rest of their word or the next argument, `-i` takes only an attached
# suffix (`-i.bak`; so `-in` means suffix "n"), and long options accept
# unambiguous prefixes. `tokenize` turns argv into `Arg` values and
# `parse_args` folds them into `Options`.

# One -e text or -f file name, in command-line order.
pub class ScriptPiece {
    pub let from_file: bool;
    pub let value: string;

    new(from_file: bool, value: string) {
        this.from_file = from_file;
        this.value = value;
    }
}

# The parsed command line. A class, not a struct: it crosses module
# boundaries, and native builds corrupt struct values that do so when
# another type shares field names (see AGENTS.md).
pub class Options {
    pub var help: bool = false;
    pub var version: bool = false;
    pub var quiet: bool = false;
    pub var extended: bool = false;
    pub var in_place: bool = false;
    pub var suffix: string = "";
    pub var pieces: list[ScriptPiece] = [];
    pub var files: list[string] = [];
}

# A command-line error: `message` has no `sed: ` prefix and may be empty;
# `usage` asks for the usage text after it.
pub class ArgError {
    pub let message: string;
    pub let usage: bool;

    new(message: string, usage: bool) {
        this.message = message;
        this.usage = usage;
    }
}

pub enum Arg {
    Opt(key: string, value: string),
    Operand(text: string),
    Bad(message: string),
}

pub struct LongOption {
    pub name: string;
    pub key: string;
    pub value: int;     # 0 none, 1 required, 2 optional (only as --name=VALUE)
}

const SHORT_FLAGS: string = "nEr";
const SHORT_WITH_VALUE: string = "ef";

pub func long_options(): list[LongOption] {
    return [
        LongOption(name = "quiet", key = "n", value = 0),
        LongOption(name = "silent", key = "n", value = 0),
        LongOption(name = "expression", key = "e", value = 1),
        LongOption(name = "file", key = "f", value = 1),
        LongOption(name = "in-place", key = "i", value = 2),
        LongOption(name = "regexp-extended", key = "E", value = 0),
        LongOption(name = "help", key = "help", value = 0),
        LongOption(name = "version", key = "version", value = 0),
    ];
}

# Indexes of the long options `name` selects: the exact match if there is
# one, otherwise every option it is a prefix of.
pub func find_long(name: string): list[int] {
    let table = long_options();
    var found: list[int] = [];
    var i = 0;
    while (i < table.len()) {
        if (table[i].name == name) {
            return [i];
        }
        if (name.len() > 0 and table[i].name.startsWith(name)) {
            found.push(i);
        }
        i += 1;
    }
    return found;
}

func chars_of(text: string): list[string] {
    var out: list[string] = [];
    for (ch in text) {
        out.push(ch);
    }
    return out;
}

# Turns argv into options, operands and (at the first error) a Bad element.
pub func tokenize(argv: list[string]): list[Arg] {
    var out: list[Arg] = [];
    var i = 0;
    var only_operands = false;
    while (i < argv.len()) {
        let arg = argv[i];
        i += 1;
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            out.push(Arg.Operand(text = arg));
            continue;
        }
        if (arg == "--") {
            only_operands = true;
            continue;
        }

        if (arg.startsWith("--")) {
            let body = arg.slice(2);
            let eq = body.index_of("=");
            let name = if (eq >= 0) { body.slice(0, eq) } else { body };
            let found = find_long(name);
            if (found.len() == 0) {
                out.push(Arg.Bad(message = i"unrecognized option '{$ arg $}'"));
                return out;
            }
            let table = long_options();
            if (found.len() > 1) {
                var names = "";
                for (k in found) {
                    names += i" '--{$ table[k].name $}'";
                }
                out.push(Arg.Bad(message = i"option '--{$ name $}' is ambiguous; possibilities:{$ names $}"));
                return out;
            }
            let opt = table[found[0]];
            var value = "";
            if (opt.value == 1) {
                if (eq >= 0) {
                    value = body.slice(eq + 1);
                } else if (i < argv.len()) {
                    value = argv[i];
                    i += 1;
                } else {
                    out.push(Arg.Bad(message = i"option '--{$ opt.name $}' requires an argument"));
                    return out;
                }
            } else if (opt.value == 2) {
                if (eq >= 0) {
                    value = body.slice(eq + 1);
                }
            } else if (eq >= 0) {
                out.push(Arg.Bad(message = i"option '--{$ opt.name $}' doesn't allow an argument"));
                return out;
            }
            out.push(Arg.Opt(key = opt.key, value = value));
            continue;
        }

        # A cluster of short options.
        let chars = chars_of(arg);
        var j = 1;
        while (j < chars.len()) {
            let c = chars[j];
            j += 1;
            if (c == "i") {
                out.push(Arg.Opt(key = "i", value = arg.slice(j)));
                break;
            }
            if (SHORT_WITH_VALUE.index_of(c) >= 0) {
                var value = "";
                if (j < chars.len()) {
                    value = arg.slice(j);
                } else if (i < argv.len()) {
                    value = argv[i];
                    i += 1;
                } else {
                    out.push(Arg.Bad(message = i"option requires an argument -- '{$ c $}'"));
                    return out;
                }
                out.push(Arg.Opt(key = c, value = value));
                break;
            }
            if (SHORT_FLAGS.index_of(c) >= 0) {
                out.push(Arg.Opt(key = c, value = ""));
                continue;
            }
            out.push(Arg.Bad(message = i"invalid option -- '{$ c $}'"));
            return out;
        }
    }
    return out;
}

pub safe func parse_args(argv: list[string]): Result[Options, ArgError] {
    let opts = Options();
    var operands: list[string] = [];

    for (tok in tokenize(argv)) {
        match tok {
            Arg.Bad(message) => {
                return Err(ArgError(message, true));
            },
            Arg.Operand(text) => {
                operands.push(text);
            },
            Arg.Opt(key, value) => {
                if (key == "n") {
                    opts.quiet = true;
                } else if (key == "E" or key == "r") {
                    opts.extended = true;
                } else if (key == "e") {
                    opts.pieces.push(ScriptPiece(false, value));
                } else if (key == "f") {
                    opts.pieces.push(ScriptPiece(true, value));
                } else if (key == "i") {
                    opts.in_place = true;
                    opts.suffix = value;
                } else if (key == "help") {
                    opts.help = true;
                } else if (key == "version") {
                    opts.version = true;
                }
            },
        }
    }

    if (opts.help or opts.version) {
        return Ok(opts);
    }
    var first_file = 0;
    if (opts.pieces.len() == 0) {
        if (operands.len() == 0) {
            return Err(ArgError("", true));
        }
        opts.pieces.push(ScriptPiece(false, operands[0]));
        first_file = 1;
    }
    opts.files = operands.slice(first_file);
    return Ok(opts);
}
