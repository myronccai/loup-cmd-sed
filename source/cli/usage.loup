@mode(host.dual)

# Help and version text for sed: usage() is printed by --help and after a
# usage error, version_line() by --version.
#
# Runtime: host.dual. Compiled into the native binary build/sed by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        "Usage: sed [OPTION]... {script-only-if-no-other-script} [input-file]...",
        "",
        "  -n, --quiet, --silent",
        "                 suppress automatic printing of pattern space",
        "  -e script, --expression=script",
        "                 add the script to the commands to be executed",
        "  -f script-file, --file=script-file",
        "                 add the contents of script-file to the commands to be executed",
        "  -i[SUFFIX], --in-place[=SUFFIX]",
        "                 edit files in place (makes backup if SUFFIX supplied)",
        "  -E, -r, --regexp-extended",
        "                 use extended regular expressions in the script",
        "                 (for portability use POSIX -E).",
        "      --help     display this help and exit",
        "      --version  output version information and exit",
        "",
        "If no -e, --expression, -f, or --file option is given, then the first",
        "non-option argument is taken as the sed script to interpret.  All",
        "remaining arguments are names of input files; if no input files are",
        "specified, then the standard input is read.",
        "",
        "Commands: s y d p q = a i c { } and #; addresses N, $, /RE/, \\cREc,",
        "A,B ranges and !.  The hold space and branching are not implemented.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
