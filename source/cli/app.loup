@mode(host.dual)

# The command-line driver of sed: parses argv, answers --help and --version,
# runs the editor and turns the outcome into GNU sed's exit status.
#
# Runtime: host.dual. Compiled into the native binary build/sed by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/app_test.loup calls run() directly under Stage0 (`make test`).

from appinfo import (APP_NAME, EXIT_OK, EXIT_BAD_USAGE, EXIT_PANIC);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.sed import (run_sed);

# Parses argv, runs sed and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(e) => {
            if (e.message.len() > 0) {
                printErr(APP_NAME + ": " + e.message);
            }
            if (e.usage) {
                printErr(usage());
            }
            return EXIT_BAD_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_sed(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_PANIC;
    }
}
