@mode(host.dual)

# Unit tests for sed's command-line parsing (source/cli/args.loup): script
# and file operands, -e/-f order, option permutation and prefixes, -i
# suffixes and usage errors.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (Options, ArgError, parse_args, tokenize, find_long);

func ok(argv: list[string]): Options {
    return parse_args(argv).unwrap();
}

func error_of(argv: list[string]): ArgError {
    return parse_args(argv).unwrap_err();
}

func test_script_operand_then_files(): void {
    let o = ok(["s/a/b/", "x.txt", "y.txt"]);
    expectEq(o.pieces.len(), 1, "one piece");
    expectEq(o.pieces[0].value, "s/a/b/", "script");
    expect(!o.pieces[0].from_file, "an expression");
    expectEq(o.files.len(), 2, "two files");
}

func test_e_and_f_pieces_keep_their_order(): void {
    let o = ok(["-e", "p", "-f", "s.sed", "--expression=d", "in.txt"]);
    expectEq(o.pieces.len(), 3, "three pieces");
    expect(o.pieces[1].from_file, "-f");
    expectEq(o.pieces[2].value, "d", "--expression=");
    expectEq(o.files[0], "in.txt", "every operand is a file");
}

func test_flags_and_permutation(): void {
    let o = ok(["p", "f.txt", "-nE"]);
    expect(o.quiet and o.extended, "-nE after the operands");
    expect(ok(["-r", "p"]).extended, "-r");
    expect(ok(["--silent", "p"]).quiet, "--silent");
    expect(ok(["--qu", "p"]).quiet, "prefix of --quiet");
}

func test_in_place_suffixes(): void {
    let plain = ok(["-i", "p", "f"]);
    expect(plain.in_place, "-i");
    expectEq(plain.suffix, "", "no suffix");
    expectEq(ok(["-i.bak", "p", "f"]).suffix, ".bak", "-i.bak");
    expectEq(ok(["-ni", "p", "f"]).suffix, "", "-ni");
    expectEq(ok(["-in", "p", "f"]).suffix, "n", "-in means suffix n");
    expectEq(ok(["--in-place=~", "p", "f"]).suffix, "~", "--in-place=");
    expectEq(ok(["--in-place", "p", "f"]).files[0], "f", "--in-place takes no separate value");
}

func test_double_dash(): void {
    let o = ok(["-n", "--", "-p"]);
    expectEq(o.pieces[0].value, "-p", "script after --");
}

func test_usage_errors(): void {
    let none: list[string] = [];
    let bare = error_of(none);
    expectEq(bare.message, "", "no script");
    expect(bare.usage, "usage text");
    expectEq(error_of(["-k", "p"]).message, "invalid option -- 'k'", "-k");
    expectEq(error_of(["--foo"]).message, "unrecognized option '--foo'", "--foo");
    expectEq(error_of(["-e"]).message, "option requires an argument -- 'e'", "-e");
    expectEq(error_of(["--file"]).message, "option '--file' requires an argument", "--file");
    expectEq(error_of(["--quiet=1", "p"]).message, "option '--quiet' doesn't allow an argument", "--quiet=1");
    expectEq(find_long("version").len(), 1, "exact");
    expectEq(find_long("nothing").len(), 0, "unknown");
}

func test_help_and_version_need_no_script(): void {
    expect(ok(["--help"]).help, "--help");
    expect(ok(["--vers"]).version, "--vers");
}

func test_tokenize_stops_at_first_error(): void {
    expectEq(tokenize(["-n", "-k", "-E"]).len(), 2, "-n then the bad -k");
}
